<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- Mirelurk Infestation (any coast) -->

    <IncidentDef>
        <defName>FCP_MirelurkInfestation</defName>
        <label>mirelurk infestation</label>
        <targetTags>
            <li>Map_PlayerHome</li>
        </targetTags>
        <workerClass>FCP.Core.IncidentWorker_GautletSpawner</workerClass>
        <letterLabel>Mirelurks nesting</letterLabel>
        <letterText>A clutch of mirelurk eggs has been laid along the coast near your colony! They will hatch soon and establish more nesting grounds.\n\nThe clutches will hatch more mirelurks and spread along the shoreline.\n\nIf you don't want the mirelurks to overrun the coast, destroy the egg clutches. But beware - the creatures will defend their eggs.</letterText>
        <letterDef>ThreatBig</letterDef>
        <baseChance>2.0</baseChance>
        <minRefireDays>20</minRefireDays>
        <category>ThreatBig</category>
        <pointsScaleable>true</pointsScaleable>
        <minThreatPoints>400</minThreatPoints>
        <modExtensions>
            <li Class="FCP.Core.IncidentExtension_GautletSpawnCondition">
                <allowedTerrains>
                    <li>Sand</li>
                    <li>WaterOceanShallow</li>
                    <li>WaterOceanDeep</li>
                </allowedTerrains>
                <disallowedTerrains />
                <isAllowRoofed>false</isAllowRoofed>
                <isAllowFogged>false</isAllowFogged>
                <radius>6</radius>
                <factionDef>FCP_Faction_Lurker</factionDef>
                <thingDef>FCP_Infestation_EggClutch_Mirelurk</thingDef>
                <spawnerPoint>0</spawnerPoint>
                <count>3</count>
            </li>
        </modExtensions>
    </IncidentDef>

